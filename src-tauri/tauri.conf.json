{
  "build": {
    "beforeDevCommand": "pnpm dev-web",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "productName": "Hermanar",
  "version": "0.2.0",
  "identifier": "com.hermanar.app",
  "plugins": {
    "process": {
      "active": true
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Hermanar - Sistema de Gestión de Hermandades",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "maximized": true
      }
    ]
  }
}