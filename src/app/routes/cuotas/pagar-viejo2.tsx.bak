import { Card } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Select } from '@/components/ui/select'
import { CreditCard, User, Users, Check, AlertCircle } from 'lucide-react'
import { useState, useEffect, useMemo } from 'react'
import { invoke } from '@tauri-apps/api/core'
import type { Cuota, Familia } from '@/types'

interface Hermano {
    id: number
    nombre: string
    primer_apellido: string
    segundo_apellido?: string
    numero_hermano: string
    familia_id?: number
    activo: boolean
}

interface CuotaFamiliar {
    familia_id: number
    familia_nombre: string
    anio: number
    trimestre: number
    total_importe: number
    num_hermanos: number
    cuotas: Cuota[]
}

export function Component() {
    const [cuotasPendientes, setCuotasPendientes] = useState<Cuota[]>([])
    const [hermanos, setHermanos] = useState<Hermano[]>([])
    const [familias, setFamilias] = useState<Familia[]>([])
    const [loading, setLoading] = useState(true)
    const [selectedItems, setSelectedItems] = useState<Set<string>>(new Set())
    const [metodoPago, setMetodoPago] = useState<
        'efectivo' | 'transferencia' | 'domiciliacion' | 'bizum'
    >('efectivo')
    const [isProcessing, setIsProcessing] = useState(false)
    const [searchTerm, setSearchTerm] = useState('')
    const [yearFilter, setYearFilter] = useState<string>('')
    const [resultado, setResultado] = useState<{
        tipo: 'success' | 'error'
        mensaje: string
    } | null>(null)

    useEffect(() => {
        loadData()
    }, [])

    const loadData = async () => {
        try {
            const [cuotas, hermanosData, familiasData] = await Promise.all([
                invoke<Cuota[]>('get_cuotas_pendientes_cmd'),
                invoke<Hermano[]>('get_all_hermanos_cmd'),
                invoke<Familia[]>('get_all_familias_cmd')
            ])
            setCuotasPendientes(cuotas)
            setHermanos(hermanosData)
            setFamilias(familiasData)
        } catch (error) {
            console.error('Error loading data:', error)
        } finally {
            setLoading(false)
        }
    }

    const getHermanoName = (hermanoId: number) => {
        const hermano = hermanos.find((h) => h.id === hermanoId)
        return hermano
            ? `${hermano.nombre} ${hermano.primer_apellido} ${hermano.segundo_apellido || ''}`
            : 'Hermano no encontrado'
    }

    const getHermanoNumber = (hermanoId: number) => {
        const hermano = hermanos.find((h) => h.id === hermanoId)
        return hermano?.numero_hermano || '-'
    }

    // Agrupar cuotas por familias y hermanos sin familia
    const { cuotasFamiliares, cuotasIndividuales } = useMemo(() => {
        const cuotasFiltradas = cuotasPendientes.filter((cuota) => {
            const hermanoName = getHermanoName(cuota.hermano_id).toLowerCase()
            const hermanoNumber = getHermanoNumber(cuota.hermano_id).toString()

            const matchesSearch =
                searchTerm === '' ||
                hermanoName.includes(searchTerm.toLowerCase()) ||
                hermanoNumber.includes(searchTerm)

            const matchesYear =
                yearFilter === '' || cuota.anio.toString() === yearFilter

            return matchesSearch && matchesYear
        })

        const familiares: CuotaFamiliar[] = []
        const individuales: Cuota[] = []

        // Agrupar por familia_id, año y trimestre
        const gruposFamilia = new Map<string, Cuota[]>()

        cuotasFiltradas.forEach((cuota) => {
            const hermano = hermanos.find((h) => h.id === cuota.hermano_id)
            
            if (hermano && hermano.familia_id && hermano.activo) {
                const key = `${hermano.familia_id}-${cuota.anio}-${cuota.trimestre}`
                if (!gruposFamilia.has(key)) {
                    gruposFamilia.set(key, [])
                }
                gruposFamilia.get(key)!.push(cuota)
            } else {
                individuales.push(cuota)
            }
        })

        // Convertir grupos en CuotaFamiliar
        gruposFamilia.forEach((cuotas, key) => {
            const [familiaIdStr] = key.split('-')
            const familiaId = parseInt(familiaIdStr)
            const familia = familias.find((f) => f.id === familiaId)
            
            if (familia && cuotas.length > 0) {
                const primeracuota = cuotas[0]
                familiares.push({
                    familia_id: familiaId,
                    familia_nombre: familia.nombre_familia,
                    anio: primeracuota.anio,
                    trimestre: primeracuota.trimestre,
                    total_importe: cuotas.reduce((sum, c) => sum + c.importe, 0),
                    num_hermanos: cuotas.length,
                    cuotas
                })
            }
        })

        return { cuotasFamiliares: familiares, cuotasIndividuales: individuales }
    }, [cuotasPendientes, hermanos, familias, searchTerm, yearFilter])

    const availableYears = useMemo(() => {
        const years = [...new Set(cuotasPendientes.map((c) => c.anio))]
        return years.sort((a, b) => b - a)
    }, [cuotasPendientes])

    const handleSelectItem = (id: string) => {
        const newSelected = new Set(selectedItems)
        if (newSelected.has(id)) {
            newSelected.delete(id)
        } else {
            newSelected.add(id)
        }
        setSelectedItems(newSelected)
    }

    const handleSelectAll = () => {
        const allIds = [
            ...cuotasFamiliares.map(cf => `familia-${cf.familia_id}-${cf.anio}-${cf.trimestre}`),
            ...cuotasIndividuales.map(c => `cuota-${c.id}`)
        ]
        
        if (selectedItems.size === allIds.length) {
            setSelectedItems(new Set())
        } else {
            setSelectedItems(new Set(allIds))
        }
    }

    const handlePagarSeleccionadas = async () => {
        if (selectedItems.size === 0) {
            setResultado({
                tipo: 'error',
                mensaje: 'Selecciona al menos una cuota o familia para pagar'
            })
            return
        }

        // Calcular total
        let totalImporte = 0
        selectedItems.forEach(id => {
            if (id.startsWith('familia-')) {
                const [, familiaId, anio, trimestre] = id.split('-')
                const cf = cuotasFamiliares.find(
                    cf => cf.familia_id === parseInt(familiaId) && 
                    cf.anio === parseInt(anio) && 
                    cf.trimestre === parseInt(trimestre)
                )
                if (cf) totalImporte += cf.total_importe
            } else {
                const cuotaId = parseInt(id.replace('cuota-', ''))
                const cuota = cuotasIndividuales.find(c => c.id === cuotaId)
                if (cuota) totalImporte += cuota.importe
            }
        })

        const metodoPagoLabel =
            metodoPago === 'efectivo'
                ? 'Efectivo'
                : metodoPago === 'transferencia'
                  ? 'Transferencia'
                  : metodoPago === 'bizum'
                    ? 'Bizum'
                    : 'Domiciliación'
        
        const confirmMessage = `¿Confirma el pago?\n\nTotal a pagar: €${totalImporte.toFixed(2)}\nMétodo de pago: ${metodoPagoLabel}\n\nEsta acción marcará las cuotas como pagadas.`

        if (!window.confirm(confirmMessage)) {
            return
        }

        setIsProcessing(true)
        setResultado(null)

        const fechaPago = new Date().toISOString().split('T')[0]
        let cuotasPagadas = 0
        let errores = 0

        try {
            for (const id of selectedItems) {
                if (id.startsWith('familia-')) {
                    const [, familiaId, anio, trimestre] = id.split('-')
                    try {
                        const numPagadas = await invoke<number>('pagar_cuotas_familia_cmd', {
                            familiaId: parseInt(familiaId),
                            anio: parseInt(anio),
                            trimestre: parseInt(trimestre),
                            fechaPago,
                            metodoPago
                        })
                        cuotasPagadas += numPagadas
                    } catch (error) {
                        console.error('Error al pagar cuotas de familia:', error)
                        errores++
                    }
                } else {
                    const cuotaId = parseInt(id.replace('cuota-', ''))
                    try {
                        await invoke('marcar_cuota_pagada_cmd', {
                            id: cuotaId,
                            fechaPago,
                            metodoPago
                        })
                        cuotasPagadas++
                    } catch (error) {
                        console.error('Error al marcar cuota como pagada:', error)
                        errores++
                    }
                }
            }

            if (errores === 0) {
                setResultado({
                    tipo: 'success',
                    mensaje: `Se han marcado ${cuotasPagadas} cuotas como pagadas correctamente`
                })
            } else {
                setResultado({
                    tipo: 'error',
                    mensaje: `Se procesaron ${cuotasPagadas} cuotas correctamente, pero hubo ${errores} errores`
                })
            }

            setSelectedItems(new Set())
            setTimeout(() => {
                loadData()
            }, 100)
        } catch (error) {
            setResultado({
                tipo: 'error',
                mensaje: 'Error al procesar los pagos'
            })
        } finally {
            setIsProcessing(false)
        }
    }

    const formatCurrency = (amount: number) => {
        return new Intl.NumberFormat('es-ES', {
            style: 'currency',
            currency: 'EUR'
        }).format(amount)
    }

    if (loading) {
        return (
            <Card title="Pago de Cuotas" subtitle="Cargando...">
                <div className="flex items-center justify-center py-8">
                    <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                    <span className="ml-2 text-gray-600">
                        Cargando cuotas pendientes...
                    </span>
                </div>
            </Card>
        )
    }

    const totalPendiente = cuotasPendientes.reduce((sum, c) => sum + c.importe, 0)

    return (
        <div className="space-y-6">
            <Card
                title="Pago de Cuotas"
                subtitle="Gestionar el pago de cuotas pendientes (individuales y familiares)"
            >
                <div className="space-y-4">
                    <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                        <div className="flex items-start space-x-3">
                            <AlertCircle className="w-5 h-5 text-yellow-600 mt-0.5" />
                            <div>
                                <h4 className="text-sm font-medium text-yellow-800 mb-1">
                                    Cuotas Pendientes
                                </h4>
                                <p className="text-sm text-yellow-700">
                                    Total de cuotas pendientes:{' '}
                                    <strong>{cuotasPendientes.length}</strong>{' '}
                                    por un importe de{' '}
                                    <strong>{formatCurrency(totalPendiente)}</strong>
                                </p>
                                <p className="text-sm text-yellow-700 mt-1">
                                    Cuotas familiares: <strong>{cuotasFamiliares.length}</strong> | 
                                    Cuotas individuales: <strong>{cuotasIndividuales.length}</strong>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <Input
                            label="Buscar hermano o familia"
                            type="text"
                            placeholder="Nombre o número..."
                            value={searchTerm}
                            onChange={(e) => setSearchTerm(e.target.value)}
                        />

                        <Select
                            label="Año"
                            value={yearFilter}
                            onChange={(e) => setYearFilter(e.target.value)}
                            options={[
                                { value: '', label: 'Todos los años' },
                                ...availableYears.map((year) => ({
                                    value: year.toString(),
                                    label: year.toString()
                                }))
                            ]}
                        />

                        <Select
                            label="Método de pago"
                            value={metodoPago}
                            onChange={(e) =>
                                setMetodoPago(
                                    e.target.value as
                                        | 'efectivo'
                                        | 'transferencia'
                                        | 'domiciliacion'
                                        | 'bizum'
                                )
                            }
                            options={[
                                { value: 'efectivo', label: 'Efectivo' },
                                { value: 'transferencia', label: 'Transferencia' },
                                { value: 'domiciliacion', label: 'Domiciliación' },
                                { value: 'bizum', label: 'Bizum' }
                            ]}
                        />
                    </div>

                    {resultado && (
                        <div
                            className={`border rounded-lg p-4 ${
                                resultado.tipo === 'success'
                                    ? 'bg-green-50 border-green-200'
                                    : 'bg-red-50 border-red-200'
                            }`}
                        >
                            <div className="flex items-start space-x-3">
                                {resultado.tipo === 'success' ? (
                                    <Check className="w-5 h-5 text-green-600 mt-0.5" />
                                ) : (
                                    <AlertCircle className="w-5 h-5 text-red-600 mt-0.5" />
                                )}
                                <div>
                                    <p
                                        className={`text-sm font-medium ${
                                            resultado.tipo === 'success'
                                                ? 'text-green-800'
                                                : 'text-red-800'
                                        }`}
                                    >
                                        {resultado.mensaje}
                                    </p>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            </Card>

            <Card
                title="Cuotas Pendientes"
                action={
                    <div className="flex items-center space-x-2">
                        <span className="text-sm text-gray-600">
                            {selectedItems.size} seleccionadas
                        </span>
                        <Button
                            onClick={handleSelectAll}
                            className="bg-gray-700 text-white hover:bg-gray-800"
                        >
                            {selectedItems.size > 0
                                ? 'Deseleccionar todas'
                                : 'Seleccionar todas'}
                        </Button>
                        <Button
                            onClick={handlePagarSeleccionadas}
                            disabled={selectedItems.size === 0 || isProcessing}
                            className="bg-green-600 hover:bg-green-700"
                        >
                            {isProcessing ? (
                                <>
                                    <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                    Procesando...
                                </>
                            ) : (
                                <>
                                    <CreditCard className="h-4 w-4 mr-2" />
                                    Pagar Seleccionadas ({selectedItems.size})
                                </>
                            )}
                        </Button>
                    </div>
                }
            >
                {cuotasFamiliares.length === 0 && cuotasIndividuales.length === 0 ? (
                    <div className="text-center py-8">
                        <Check className="w-12 h-12 text-green-500 mx-auto mb-4" />
                        <p className="text-gray-500">
                            No hay cuotas pendientes que coincidan con los filtros
                        </p>
                    </div>
                ) : (
                    <div className="space-y-6">
                        {/* Cuotas Familiares */}
                        {cuotasFamiliares.length > 0 && (
                            <div>
                                <h3 className="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                                    <Users className="h-5 w-5 mr-2 text-blue-600" />
                                    Cuotas Familiares
                                </h3>
                                <div className="space-y-2">
                                    {cuotasFamiliares.map((cf) => {
                                        const id = `familia-${cf.familia_id}-${cf.anio}-${cf.trimestre}`
                                        const isSelected = selectedItems.has(id)
                                        return (
                                            <div
                                                key={id}
                                                className={`border rounded-lg p-4 cursor-pointer transition ${
                                                    isSelected
                                                        ? 'bg-blue-50 border-blue-300'
                                                        : 'bg-white border-gray-200 hover:border-gray-300'
                                                }`}
                                                onClick={() => handleSelectItem(id)}
                                            >
                                                <div className="flex items-center justify-between">
                                                    <div className="flex items-center space-x-4">
                                                        <input
                                                            type="checkbox"
                                                            checked={isSelected}
                                                            onChange={() => handleSelectItem(id)}
                                                            onClick={(e) => e.stopPropagation()}
                                                            className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                                        />
                                                        <div>
                                                            <div className="flex items-center space-x-2">
                                                                <Users className="h-5 w-5 text-blue-600" />
                                                                <span className="font-semibold text-gray-900">
                                                                    {cf.familia_nombre}
                                                                </span>
                                                                <span className="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                                                                    {cf.num_hermanos} hermanos
                                                                </span>
                                                            </div>
                                                            <div className="text-sm text-gray-600 mt-1">
                                                                {cf.anio} - {cf.trimestre}º Trimestre
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div className="text-right">
                                                        <div className="text-lg font-bold text-gray-900">
                                                            {formatCurrency(cf.total_importe)}
                                                        </div>
                                                        <div className="text-xs text-gray-500">
                                                            Total familiar
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        )
                                    })}
                                </div>
                            </div>
                        )}

                        {/* Cuotas Individuales */}
                        {cuotasIndividuales.length > 0 && (
                            <div>
                                <h3 className="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                                    <User className="h-5 w-5 mr-2 text-green-600" />
                                    Cuotas Individuales
                                </h3>
                                <div className="overflow-x-auto">
                                    <table className="min-w-full divide-y divide-gray-200">
                                        <thead className="bg-gray-50">
                                            <tr>
                                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                    <input
                                                        type="checkbox"
                                                        onChange={() => {
                                                            const allIndividuales = cuotasIndividuales.map(c => `cuota-${c.id}`)
                                                            const allSelected = allIndividuales.every(id => selectedItems.has(id))
                                                            const newSelected = new Set(selectedItems)
                                                            
                                                            if (allSelected) {
                                                                allIndividuales.forEach(id => newSelected.delete(id))
                                                            } else {
                                                                allIndividuales.forEach(id => newSelected.add(id))
                                                            }
                                                            setSelectedItems(newSelected)
                                                        }}
                                                        className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                                    />
                                                </th>
                                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                    Hermano
                                                </th>
                                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                    Año
                                                </th>
                                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                    Trimestre
                                                </th>
                                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                    Importe
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody className="bg-white divide-y divide-gray-200">
                                            {cuotasIndividuales.map((cuota) => {
                                                const id = `cuota-${cuota.id}`
                                                const isSelected = selectedItems.has(id)
                                                return (
                                                    <tr
                                                        key={cuota.id}
                                                        className={`hover:bg-gray-50 cursor-pointer ${
                                                            isSelected ? 'bg-blue-50' : ''
                                                        }`}
                                                        onClick={() => handleSelectItem(id)}
                                                    >
                                                        <td className="px-6 py-4">
                                                            <input
                                                                type="checkbox"
                                                                checked={isSelected}
                                                                onChange={() => handleSelectItem(id)}
                                                                onClick={(e) => e.stopPropagation()}
                                                                className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                                            />
                                                        </td>
                                                        <td className="px-6 py-4">
                                                            <div className="flex items-center">
                                                                <div className="shrink-0 h-8 w-8">
                                                                    <div className="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
                                                                        <User className="h-4 w-4 text-gray-500" />
                                                                    </div>
                                                                </div>
                                                                <div className="ml-4">
                                                                    <div className="text-sm font-medium text-gray-900">
                                                                        {getHermanoName(cuota.hermano_id)}
                                                                    </div>
                                                                    <div className="text-sm text-gray-500">
                                                                        Nº {getHermanoNumber(cuota.hermano_id)}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td className="px-6 py-4">
                                                            <div className="text-sm font-medium text-gray-900">
                                                                {cuota.anio}
                                                            </div>
                                                        </td>
                                                        <td className="px-6 py-4">
                                                            <div className="text-sm text-gray-900">
                                                                {cuota.trimestre}º
                                                            </div>
                                                        </td>
                                                        <td className="px-6 py-4">
                                                            <span className="text-sm font-medium text-gray-900">
                                                                {formatCurrency(cuota.importe)}
                                                            </span>
                                                        </td>
                                                    </tr>
                                                )
                                            })}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        )}
                    </div>
                )}
            </Card>
        </div>
    )
}
